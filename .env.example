# En Railway, configura ambas credenciales en app. En Compose local son opcionales.
APP_PORT=8000
OCD_DEMO_USERNAME=demo
OCD_DEMO_PASSWORD=
# Compose local. En Railway usa la URI privada autenticada del servicio MongoDB.
MONGODB_URI=mongodb://mongodb:27017/ocd
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ATLASSIAN_BASE_URL=https://grupo-visai.atlassian.net
ATLASSIAN_EMAIL=
ATLASSIAN_API_TOKEN=
# Contrato compartido v1 entre ingesta y backend.
QDRANT_ALIAS=ocd_actual
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
