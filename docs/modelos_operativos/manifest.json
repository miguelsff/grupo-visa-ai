      "code": "MO-MIC-001",
      "category": "microservicio",
      "title": "MO-MIC-001 - Pase a producción de microservicios [DEMO]",
      "pageId": "294922",
      "url": "https://grupo-visai.atlassian.net/wiki/spaces/DDS/pages/294922/MO-MIC-001+-+Pase+a+producci+n+de+microservicios+DEMO",
      "parentPageId": "66048",
      "confluenceVersion": 1,
      "documentVersion": "1.0",
      "localFile": "MO-MIC-001.md",
      "requiredFields": [
        {
          "name": "microservicio",
          "type": "Texto",
          "when": "Siempre",
          "example": "ms-demo-transferencias"
        },
        {
          "name": "repositorio",
          "type": "URL o referencia",
          "when": "Siempre",
          "example": "https://git.example/ocd/ms-demo-transferencias"
        },
        {
          "name": "version_actual / version_objetivo",
          "type": "Texto",
          "when": "Siempre",
          "example": "1.3.0 / 1.3.1"
        },
        {
          "name": "artefacto",
          "type": "Referencia de imagen o paquete",
          "when": "Siempre",
          "example": "acr-demo.example/ms-demo-transferencias:1.3.1"
        },
        {
          "name": "identificador_inmutable",
          "type": "Digest, hash o ID de compilación",
          "when": "Antes de ejecutar el despliegue",
          "example": "PENDIENTE si todavía no está disponible"
        },
        {
          "name": "dependencias",
          "type": "Lista o NO_APLICA justificado",
          "when": "Siempre",
          "example": "Base de datos, cola o API dependiente"
        },
        {
          "name": "cambio_datos / compatibilidad",
          "type": "Sí/no y explicación",
          "when": "Si cambia un contrato o datos",
          "example": "Sin migración de datos para los ejemplos"
        },
        {
          "name": "pruebas_y_reversion",
          "type": "Pasos y criterios observables",
          "when": "Siempre",
          "example": "Idempotencia y recuperación de la versión anterior"
        }
      ],
      "rules": [
        {
          "id": "MIC-R01",
          "ruleClass": "Completitud",
          "fields": "microservicio, repositorio, versiones, artefacto",
          "result": "FALTA_INFORMACION si falta un dato obligatorio del baseline.",
          "mode": "Documental automática"
        },
        {
          "id": "MIC-R02",
          "ruleClass": "Consistencia",
          "fields": "version_actual y version_objetivo",
          "result": "ERROR si son iguales y el cambio afirma publicar una versión diferente.",
          "mode": "Documental automática"
        },
        {
          "id": "MIC-R03",
          "ruleClass": "Consistencia",
          "fields": "artefacto y version_objetivo",
          "result": "ERROR si el tag o la referencia del artefacto contradice la versión declarada.",
          "mode": "Documental automática"
        },
        {
          "id": "MIC-R04",
          "ruleClass": "Trazabilidad",
          "fields": "pruebas y reversión",
          "result": "FALTA_INFORMACION si no existe un criterio funcional o una versión/configuración recuperable.",
          "mode": "Documental automática"
        },
        {
          "id": "MIC-R05",
          "ruleClass": "Ejecución",
          "fields": "salud y pruebas de negocio",
          "result": "NO_VERIFICABLE sin ejecución o evidencia accesible del ambiente objetivo.",
          "mode": "Técnica mediante evidencia"
        }
      ],
      "examples": [
