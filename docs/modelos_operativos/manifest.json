  "index": {
    "code": "MO-OCD-000",
    "title": "DEMO OCD - Índice y reglas comunes",
    "pageId": "66048",
    "url": "https://grupo-visai.atlassian.net/wiki/spaces/DDS/pages/66048/DEMO+OCD+-+ndice+y+reglas+comunes",
    "confluenceVersion": 1,
    "documentVersion": "1.0",
    "localFile": "README.md",
    "commonRules": [
      {
        "id": "OCD-C01",
        "ruleClass": "Completitud",
        "condition": "Título, objetivo, solicitante/rol, responsable/rol, etapa, ambientes, ventana con zona horaria e impacto.",
        "result": "FALTA_INFORMACION si falta un dato."
      },
      {
        "id": "OCD-C02",
        "ruleClass": "Trazabilidad",
        "condition": "Incluir planes de ejecución, pruebas y reversión con resultados esperados.",
        "result": "FALTA_INFORMACION si falta un plan o criterio."
      },
      {
        "id": "OCD-C03",
        "ruleClass": "Consistencia",
        "condition": "Mantener separados certificación y producción; identificar dependencias y su ambiente.",
        "result": "ERROR si una referencia contradice el ambiente declarado."
      },
      {
        "id": "OCD-C04",
        "ruleClass": "Trazabilidad",
        "condition": "Registrar modelo, versión y regla utilizados. Mantener las evidencias faltantes como pendientes.",
        "result": "NO_VERIFICABLE para ejecuciones sin evidencia accesible."
      },
      {
        "id": "OCD-C05",
        "ruleClass": "Protección de datos",
        "condition": "Usar referencias de credenciales y omitir valores sensibles en ticket, chat y registros.",
        "result": "ERROR ante una exposición detectada; la detección no garantiza ausencia de secretos."
      },
      {
        "id": "OCD-C06",
        "ruleClass": "Procedencia",
        "condition": "Usar modelos operativos como reglas y tickets como ejemplos. No copiar datos desconocidos de otro ticket.",
        "result": "FALTA_INFORMACION cuando el agente necesita un dato del solicitante."
      }
    ]
  },
