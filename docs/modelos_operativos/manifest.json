      "code": "MO-RED-001",
      "category": "red",
      "title": "MO-RED-001 - Accesos de red [DEMO]",
      "pageId": "98314",
      "url": "https://grupo-visai.atlassian.net/wiki/spaces/DDS/pages/98314/MO-RED-001+-+Accesos+de+red+DEMO",
      "parentPageId": "66048",
      "confluenceVersion": 1,
      "documentVersion": "1.0",
      "localFile": "MO-RED-001.md",
      "requiredFields": [
        {
          "name": "origen / ambiente_origen",
          "type": "IP, CIDR o referencia lógica y ambiente",
          "when": "Siempre",
          "example": "10.240.10.0/24 / prod-demo"
        },
        {
          "name": "destino / ambiente_destino",
          "type": "IP o CIDR de regla y referencia del recurso",
          "when": "Siempre",
          "example": "10.240.20.10 / SQL privado / prod-demo"
        },
        {
          "name": "nombre_dns",
          "type": "FQDN",
          "when": "Si se utiliza resolución de nombres",
          "example": "api-riesgo.demo.example"
        },
        {
          "name": "protocolo / puerto_destino",
          "type": "TCP o UDP; número o rango",
          "when": "Siempre",
          "example": "TCP / 1433"
        },
        {
          "name": "puerto_origen",
          "type": "Puerto o efímero según el flujo",
          "when": "Al definir la regla ejecutable",
          "example": "Efímero; justificar comodines cuando correspondan"
        },
        {
          "name": "sentido / finalidad",
          "type": "Entrada o salida y necesidad del flujo",
          "when": "Siempre",
          "example": "Salida para consultar la base de datos"
        },
        {
          "name": "punto_control / regla",
          "type": "NSG, firewall u otro control; nombre de regla",
          "when": "Antes de ejecutar",
          "example": "demo-red-01; control específico pendiente"
        },
        {
          "name": "regla_anterior / reversion",
          "type": "Descripción y retirada del cambio concreto",
          "when": "Siempre",
          "example": "Retirar únicamente demo-red-01"
        }
      ],
      "rules": [
        {
          "id": "RED-R01",
          "ruleClass": "Completitud",
          "fields": "origen, destino, ambientes, protocolo, puerto y finalidad",
          "result": "FALTA_INFORMACION si no puede reconstruirse el flujo solicitado.",
          "mode": "Documental automática"
        },
        {
          "id": "RED-R02",
          "ruleClass": "Consistencia",
          "fields": "IP/CIDR y puertos",
          "result": "ERROR ante IP/CIDR inválido, puerto fuera de 1–65535 o rango invertido.",
          "mode": "Documental automática"
        },
        {
          "id": "RED-R03",
          "ruleClass": "Consistencia",
          "fields": "protocolo y DNS",
          "result": "El caso DNS de demo declara UDP y TCP/53. FALTA_INFORMACION si solo indica «abrir DNS».",
          "mode": "Documental automática"
        },
        {
          "id": "RED-R04",
          "ruleClass": "Trazabilidad",
          "fields": "control, nombre de regla y reversión",
          "result": "FALTA_INFORMACION antes de ejecutar si no se identifica qué regla agregar y retirar.",
          "mode": "Documental automática"
        },
        {
          "id": "RED-R05",
          "ruleClass": "Ejecución",
          "fields": "rutas, resolución, filtrado y alcance efectivo",
          "result": "NO_VERIFICABLE sin consulta o prueba técnica accesible. Un puerto escrito no demuestra conectividad.",
          "mode": "Técnica mediante evidencia"
        }
      ],
      "examples": [
