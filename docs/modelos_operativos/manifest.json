      "title": "MO-ID-001 - Identidades de servicio con Microsoft Entra ID [DEMO]",
      "pageId": "294943",
      "url": "https://grupo-visai.atlassian.net/wiki/spaces/DDS/pages/294943/MO-ID-001+-+Identidades+de+servicio+con+Microsoft+Entra+ID+DEMO",
      "parentPageId": "66048",
      "confluenceVersion": 1,
      "documentVersion": "1.0",
      "localFile": "MO-ID-001.md",
      "requiredFields": [
        {
          "name": "tenant / nombre_identidad",
          "type": "Identificador o marcador de demo y nombre solicitado",
          "when": "Siempre",
          "example": "TENANT-DEMO / sp-demo-emisor-notificaciones"
        },
        {
          "name": "consumidor / finalidad",
          "type": "Aplicación o pipeline y uso esperado",
          "when": "Siempre",
          "example": "ms-demo-productor-notificaciones / enviar mensajes"
        },
        {
          "name": "identidad_nueva / existente",
          "type": "Selección y referencia",
          "when": "Siempre",
          "example": "Nueva; todavía sin client ID ni object ID"
        },
        {
          "name": "client_id / object_id",
          "type": "Identificadores diferenciados",
          "when": "Si existe la identidad",
          "example": "Registrar los valores reales solo al disponer de ellos"
        },
        {
          "name": "mecanismo_autenticacion",
          "type": "Federación o certificado en los casos de demo",
          "when": "Siempre",
          "example": "OIDC o referencia de certificado"
        },
        {
          "name": "confianza_o_certificado",
          "type": "Emisor, sujeto y audiencia; o referencia y vigencia",
          "when": "Según el mecanismo",
          "example": "Pipeline y ambiente concretos; sin claves privadas"
        },
        {
          "name": "destino / tipo_autorizacion",
          "type": "Recurso Azure o API y mecanismo",
          "when": "Siempre",
          "example": "Cola Service Bus / Azure RBAC"
        },
        {
          "name": "rol_y_alcance",
          "type": "Rol y recurso; o app role y API",
          "when": "Siempre",
          "example": "Azure Service Bus Data Sender / cola concreta"
        },
        {
          "name": "pruebas / revocacion",
          "type": "Prueba permitida, denegación y retirada",
          "when": "Siempre",
          "example": "Enviar un mensaje y denegar recepción"
        }
      ],
      "rules": [
        {
          "id": "ID-R01",
          "ruleClass": "Completitud",
          "fields": "tenant, identidad, consumidor, destino y finalidad",
          "result": "FALTA_INFORMACION si no se conoce quién accede a qué y para qué.",
          "mode": "Documental automática"
        },
        {
          "id": "ID-R02",
          "ruleClass": "Consistencia",
          "fields": "autenticación y referencias",
          "result": "ERROR si incluye una clave privada, contraseña o token como contenido del ticket; los identificadores públicos no son secretos.",
          "mode": "Documental con detección limitada"
        },
        {
          "id": "ID-R03",
          "ruleClass": "Consistencia",
          "fields": "tipo de autorización, rol y alcance",
          "result": "FALTA_INFORMACION si un rol Azure RBAC carece de alcance o un app role carece de API destino.",
          "mode": "Documental automática"
        },
        {
          "id": "ID-R04",
          "ruleClass": "Trazabilidad",
          "fields": "pruebas positiva/negativa y revocación",
          "result": "FALTA_INFORMACION si no describe acceso permitido, denegación y retirada de asignaciones nuevas.",
          "mode": "Documental automática"
        },
        {
          "id": "ID-R05",
          "ruleClass": "Ejecución",
          "fields": "confianza, token y permiso efectivo",
          "result": "NO_VERIFICABLE sin evidencia de autenticación y operación en el destino. Leer un token no prueba su validez.",
          "mode": "Técnica mediante evidencia"
        }
      ],
